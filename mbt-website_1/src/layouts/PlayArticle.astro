---
import '@fontsource/fredoka/400.css';
import '@fontsource/fredoka/500.css';
import '@fontsource/fredoka/600.css';
import '@fontsource/fredoka/700.css';
import '@fontsource/quicksand/500.css';
import '@fontsource/quicksand/600.css';
import '@fontsource/quicksand/700.css';
import css from '../styles/play.css?raw';
interface Props {
  title: string;
  description: string;
  category: string;
  dateStr: string;
  coverImage?: string;
  schema?: string;
}
const { title, description, category, dateStr, coverImage, schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const APP = 'https://apps.apple.com/au/app/mini-brains-play/id6803676635';
const BRAND = `<a class="brand" href="/" aria-label="Mini Brains Play"><img src="/logo-play.png" alt="Mini Brains Play" style="height:42px;display:block"></a>`;
const NAV = `<nav class="nav"><div class="wrap">${BRAND}<div class="navlinks"><a href="/about/">About</a><a href="/school-readiness/">School readiness</a><a href="/pricing/">Pricing</a><a href="/blog/">Blog</a></div><a class="btn btn-pink btn-sm" href="${APP}">Download</a></div></nav>`;
const FOOT = `<footer><div class="wrap"><div class="foot-grid"><div style="max-width:280px">${BRAND}<p style="margin-top:10px;color:#cfe3c7">Screen-free play ideas for you and your Mini. Made in Australia.</p></div><div class="foot-col"><b>Explore</b><a href="/about/">About</a><a href="/school-readiness/">School readiness</a><a href="/pricing/">Pricing</a><a href="/faq/">FAQ</a></div><div class="foot-col"><b>Mini Brains</b><a href="/blog/">Blog</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></div><div class="foot-col"><b>Get it</b><a href="${APP}">Download on iOS</a><a href="https://www.instagram.com/minibrainsplay/">Instagram</a></div></div><div class="foot-btm"><span>© 2026 Mini Brains Play</span><span>Privacy · Terms · Made with care in Australia</span></div></div></footer>`;
const ART_CSS = `
.art-wrap{max-width:760px;margin:0 auto;padding:0 20px}
.art-hero{text-align:center;padding:52px 0 8px}
.art-cat{font-family:var(--disp);font-weight:600;font-size:14px;letter-spacing:.06em;color:var(--pink);text-transform:uppercase;margin-bottom:12px}
.art-hero h1{font-family:var(--disp);font-weight:700;font-size:40px;line-height:1.12;color:var(--forest);max-width:20ch;margin:0 auto}
.art-meta{color:#8a8590;font-size:15px;margin-top:14px}
.art-cover{margin:26px auto 0;max-width:900px;border-radius:24px;overflow:hidden;box-shadow:0 18px 40px rgba(30,60,25,.14)}
.art-cover img{width:100%;display:block}
.prose{font-family:var(--body);font-size:18px;line-height:1.72;color:#3a3540;margin:34px 0 10px}
.prose p{margin:0 0 20px}
.prose h2{font-family:var(--disp);font-weight:600;font-size:27px;color:var(--forest);margin:38px 0 12px}
.prose h3{font-family:var(--disp);font-weight:600;font-size:21px;color:var(--forest);margin:28px 0 10px}
.prose a{color:var(--pink);text-decoration:underline;text-underline-offset:3px}
.prose ul,.prose ol{margin:0 0 20px;padding-left:24px}
.prose li{margin:8px 0}
.prose img{max-width:100%;border-radius:18px;margin:22px 0}
.prose blockquote{margin:24px 0;padding:6px 22px;border-left:4px solid var(--pink);color:#4a4550;font-style:italic}
.prose strong{color:var(--forest)}
.share{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:36px 0 8px;padding-top:22px;border-top:1px solid #eee}
.sharelbl{font-family:var(--disp);font-weight:600;color:var(--forest);font-size:15px;margin-right:4px}
.sbtn{width:42px;height:42px;border-radius:50%;border:none;background:var(--blush);color:var(--pink);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;position:relative;text-decoration:none}
.sbtn:hover{background:var(--pink);color:#fff}
.sbtn svg{width:20px;height:20px}
.sbtn .copied{position:absolute;bottom:-22px;left:50%;transform:translateX(-50%);font-size:11px;color:var(--green);opacity:0;transition:opacity .15s;white-space:nowrap;font-family:var(--disp)}
.sbtn.done .copied{opacity:1}
.backlink{display:inline-block;margin:20px 0 0;font-family:var(--disp);font-weight:600;color:var(--pink)}
`;
---
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-1C17V2GM8Z"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-1C17V2GM8Z');
    gtag('config', 'G-JD6S3TQGPV');
  </script>
  <title>{title} | Mini Brains Play</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow" />
  <meta property="og:type" content="article" />
  <meta property="og:locale" content="en_AU" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={coverImage ? new URL(coverImage, Astro.site).href : new URL('/logo.png', Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <style is:inline set:html={css + ART_CSS}></style>
  {schema && <Fragment set:html={schema} />}
</head>
<body>
  <Fragment set:html={NAV} />
  <main style="background:var(--cream);padding-bottom:40px">
    <div class="art-wrap">
      <header class="art-hero">
        <p class="art-cat">{category}</p>
        <h1>{title}</h1>
        <p class="art-meta">{dateStr}</p>
      </header>
      {coverImage && (
        <div class="art-cover"><img src={coverImage} alt="" /></div>
      )}
      <div class="prose">
        <slot />
      </div>
      <a class="backlink" href="/blog/">&larr; Back to the blog</a>
    </div>
  </main>
  <Fragment set:html={FOOT} />
  <script is:inline>
    (function(){
      function init(){
        var wrap=document.querySelector('.nav .wrap');
        var links=document.querySelector('.nav .navlinks');
        if(!wrap||!links||document.querySelector('.nav-burger'))return;
        var burger=document.createElement('button');
        burger.className='nav-burger';burger.type='button';
        burger.setAttribute('aria-label','Open menu');burger.setAttribute('aria-expanded','false');
        burger.innerHTML='<span></span><span></span><span></span>';
        var menu=document.createElement('div');menu.className='mobile-menu';
        var frag='';
        links.querySelectorAll('a').forEach(function(a){frag+='<a href="'+a.getAttribute('href')+'">'+a.textContent+'</a>';});
        var dl=wrap.querySelector('a.btn');
        if(dl){frag+='<a class="mm-dl" href="'+dl.getAttribute('href')+'">'+dl.textContent+'</a>';}
        menu.innerHTML=frag;
        document.body.appendChild(menu);
        wrap.appendChild(burger);
        function setOpen(o){menu.classList.toggle('open',o);burger.classList.toggle('open',o);burger.setAttribute('aria-expanded',o?'true':'false');document.body.classList.toggle('menu-open',o);}
        burger.addEventListener('click',function(){setOpen(!menu.classList.contains('open'));});
        menu.addEventListener('click',function(e){if(e.target.closest('a'))setOpen(false);});
        window.addEventListener('resize',function(){if(window.innerWidth>900)setOpen(false);});
      }
      if(document.readyState!=='loading')init();else document.addEventListener('DOMContentLoaded',init);
    })();
  </script>
</body>
</html>
