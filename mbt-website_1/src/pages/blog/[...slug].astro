---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const d = post.data;
const dateStr = d.pubDate.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });

const postUrl = new URL(`/blog/${post.slug}/`, Astro.site).href;
const orgUrl = new URL('/', Astro.site).href;
const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': postUrl + '#article',
      headline: d.title,
      description: d.description,
      mainEntityOfPage: postUrl,
      inLanguage: 'en-AU',
      datePublished: d.pubDate.toISOString(),
      dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
      author: { '@type': 'Person', name: 'Tina', url: new URL('/about/', Astro.site).href },
      publisher: { '@id': orgUrl + '#org' },
      ...(d.coverImage ? { image: new URL(d.coverImage, Astro.site).href } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: orgUrl },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: d.title, item: postUrl },
      ],
    },
  ],
};

const shareUrl = encodeURIComponent(postUrl);
const shareText = encodeURIComponent(d.title);
const shareImg = d.coverImage ? encodeURIComponent(new URL(d.coverImage, Astro.site).href) : '';
const share = {
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`,
  x: `https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`,
  pinterest: `https://pinterest.com/pin/create/button/?url=${shareUrl}&media=${shareImg}&description=${shareText}`,
  whatsapp: `https://wa.me/?text=${shareText}%20${shareUrl}`,
  email: `mailto:?subject=${shareText}&body=${shareUrl}`,
};
---
<Base title={d.title} description={d.description} article={true}>
  <main>
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <article>
      <header class="arthero">
        <p class="artcat">{d.category}</p>
        <h1>{d.title}</h1>
        <p class="artmeta">{dateStr}</p>
        {d.coverImage ? (
          <div class="artcover photo">
            <img class="cvimg" src={d.coverImage} alt="" />
          </div>
        ) : (
          <div class="artcover" style={`background:${d.coverColor}`}>
            <span class="cblob"></span>
            <img src={`/icons/${d.coverIcon}.png`} alt="" />
          </div>
        )}
      </header>
      <div class="article">
        <div class="prose">
          <Content />
        </div>

        <div class="share">
          <span class="sharelbl">Share this</span>
          <button class="sbtn native" type="button" hidden aria-label="Share (opens your device share menu, including Instagram)" data-url={postUrl} data-title={d.title}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="2.6"/><circle cx="6" cy="12" r="2.6"/><circle cx="18" cy="19" r="2.6"/><path d="M8.3 10.8 15.7 6.3"/><path d="M8.3 13.2 15.7 17.7"/></svg>
          </button>
          <a class="sbtn" href={share.facebook} target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5H17V3.6c-.3-.04-1.3-.13-2.45-.13-2.42 0-4.05 1.48-4.05 4.2v2.33H7.8V13h2.7v8h3z"/></svg>
          </a>
          <a class="sbtn" href={share.pinterest} target="_blank" rel="noopener noreferrer" aria-label="Save to Pinterest">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.5 2 4 5.6 4 8.9c0 2 .75 3.75 2.36 4.42.27.11.5 0 .58-.29.06-.2.19-.76.25-.99.08-.3.05-.41-.17-.67-.48-.57-.79-1.3-.79-2.34 0-3.02 2.26-5.72 5.88-5.72 3.21 0 4.97 1.96 4.97 4.58 0 3.45-1.53 6.36-3.79 6.36-1.25 0-2.19-1.03-1.89-2.3.36-1.51 1.06-3.14 1.06-4.23 0-.98-.52-1.79-1.6-1.79-1.27 0-2.29 1.31-2.29 3.07 0 1.12.38 1.87.38 1.87l-1.53 6.46c-.45 1.92-.07 4.28-.03 4.51.02.14.2.17.28.07.12-.15 1.6-1.98 2.1-3.81.14-.51.82-3.2.82-3.2.4.77 1.58 1.44 2.84 1.44 3.73 0 6.27-3.4 6.27-7.96C21.68 5.44 18.5 2 12 2z"/></svg>
          </a>
          <a class="sbtn" href={share.x} target="_blank" rel="noopener noreferrer" aria-label="Share on X">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.53 3h3.02l-6.6 7.54L21.75 21h-6.09l-4.77-6.23L5.42 21H2.4l7.06-8.07L2.25 3h6.24l4.31 5.7L17.53 3zm-1.06 16.2h1.67L7.6 4.7H5.8L16.47 19.2z"/></svg>
          </a>
          <a class="sbtn" href={share.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l4.98-1.32A10 10 0 1 0 12 2zm0 18.2c-1.6 0-3.16-.43-4.52-1.25l-.32-.19-2.99.79.8-2.92-.21-.33A8.2 8.2 0 1 1 12 20.2zm4.6-6.15c-.25-.13-1.48-.73-1.71-.81-.23-.09-.4-.13-.56.12-.17.25-.64.8-.79.97-.14.16-.29.18-.53.06a6.68 6.68 0 0 1-2-1.23 7.44 7.44 0 0 1-1.37-1.7c-.14-.25 0-.38.11-.5.11-.11.25-.29.37-.44.12-.14.16-.25.24-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.76-1.85-.2-.48-.4-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.22.25-.86.84-.86 2.05s.88 2.38 1 2.55c.13.16 1.73 2.64 4.2 3.71.58.25 1.04.4 1.4.52.58.18 1.12.16 1.54.1.47-.07 1.48-.6 1.69-1.19.2-.58.2-1.08.14-1.18-.06-.11-.22-.17-.47-.29z"/></svg>
          </a>
          <a class="sbtn" href={share.email} aria-label="Share by email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 7.5 8.5 5.5 8.5-5.5"/></svg>
          </a>
          <button class="sbtn copy" type="button" aria-label="Copy link" data-url={postUrl}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.5 14.5 14.5 9.5"/><path d="M11.5 6.2l1-1a4 4 0 0 1 5.66 5.66l-2 2"/><path d="M12.5 17.8l-1 1a4 4 0 0 1-5.66-5.66l2-2"/></svg>
            <span class="copied">Copied</span>
          </button>
        </div>

        <a class="backlink" href="/blog/">&larr; Back to the blog</a>
      </div>
    </article>

    <script is:inline>
      (function () {
        var copy = document.querySelector('.sbtn.copy');
        if (copy) {
          copy.addEventListener('click', function () {
            var url = copy.getAttribute('data-url');
            var done = function () {
              copy.classList.add('done');
              setTimeout(function () { copy.classList.remove('done'); }, 1600);
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(url).then(done).catch(done);
            } else {
              var t = document.createElement('textarea');
              t.value = url; document.body.appendChild(t); t.select();
              try { document.execCommand('copy'); } catch (e) {}
              document.body.removeChild(t); done();
            }
          });
        }
        var native = document.querySelector('.sbtn.native');
        if (native && navigator.share) {
          native.hidden = false;
          native.addEventListener('click', function () {
            navigator.share({
              title: native.getAttribute('data-title'),
              url: native.getAttribute('data-url'),
            }).catch(function () {});
          });
        }
      })();
    </script>

    <section class="final" id="join">
      <div class="wrap center">
        <h2>Grow these skills at home, ten minutes a day.</h2>
        <p class="lede">Mini Brains Trust turns ideas like these into ready-to-go daily play. Join the waitlist for early access.</p>
        <form class="form" id="waitlist-form" name="waitlist" method="POST" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="waitlist" />
          <p hidden><label>Leave empty: <input name="bot-field" /></label></p>
          <div class="row">
            <input type="text" name="first_name" placeholder="Your first name" autocomplete="given-name" />
            <input type="email" name="email" placeholder="Your email" required autocomplete="email" />
          </div>
          <button type="submit" class="btn lg">Join the waitlist &nbsp;&rarr;</button>
        </form>
        <div class="thanks" id="thanks">
          <div class="fred">You're on the list.</div>
          <p>Thanks for backing this early. We'll be in touch before anyone else.</p>
        </div>
      </div>
    </section>
  </main>
</Base>
