---
import PlayArticle from '../../layouts/PlayArticle.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const d = post.data;
const dateStr = d.pubDate.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });

const postUrl = new URL(`/blog/${post.slug}/`, Astro.site).href;
const orgUrl = new URL('/', Astro.site).href;
const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': postUrl + '#article',
      headline: d.title,
      description: d.description,
      mainEntityOfPage: postUrl,
      inLanguage: 'en-AU',
      datePublished: d.pubDate.toISOString(),
      dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
      author: { '@type': 'Person', name: 'Tina', url: new URL('/about/', Astro.site).href },
      publisher: { '@id': orgUrl + '#org' },
      ...(d.coverImage ? { image: new URL(d.coverImage, Astro.site).href } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: orgUrl },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: d.title, item: postUrl },
      ],
    },
  ],
};
const schemaHtml = `<script type="application/ld+json">${JSON.stringify(articleSchema)}</script>`;
---
<PlayArticle
  title={d.title}
  description={d.description}
  category={d.category}
  dateStr={dateStr}
  coverImage={d.coverImage}
  schema={schemaHtml}
>
  <Content />
</PlayArticle>
