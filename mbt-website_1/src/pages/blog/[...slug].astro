---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const d = post.data;
const dateStr = d.pubDate.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });

const postUrl = new URL(`/blog/${post.slug}/`, Astro.site).href;
const orgUrl = new URL('/', Astro.site).href;
const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': postUrl + '#article',
      headline: d.title,
      description: d.description,
      mainEntityOfPage: postUrl,
      inLanguage: 'en-AU',
      datePublished: d.pubDate.toISOString(),
      dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
      author: { '@type': 'Person', name: 'Tina', url: new URL('/about/', Astro.site).href },
      publisher: { '@id': orgUrl + '#org' },
      ...(d.coverImage ? { image: new URL(d.coverImage, Astro.site).href } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: orgUrl },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: d.title, item: postUrl },
      ],
    },
  ],
};
---
<Base title={d.title} description={d.description} article={true}>
  <main>
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <article>
      <header class="arthero">
        <p class="artcat">{d.category}</p>
        <h1>{d.title}</h1>
        <p class="artmeta">{dateStr}</p>
        {d.coverImage ? (
          <div class="artcover photo">
            <img class="cvimg" src={d.coverImage} alt="" />
          </div>
        ) : (
          <div class="artcover" style={`background:${d.coverColor}`}>
            <span class="cblob"></span>
            <img src={`/icons/${d.coverIcon}.png`} alt="" />
          </div>
        )}
      </header>
      <div class="article">
        <div class="prose">
          <Content />
        </div>
        <a class="backlink" href="/blog/">&larr; Back to the blog</a>
      </div>
    </article>

    <section class="final" id="join">
      <div class="wrap center">
        <h2>Grow these skills at home, ten minutes a day.</h2>
        <p class="lede">Mini Brains Trust turns ideas like these into ready-to-go daily play. Join the waitlist for early access.</p>
        <form class="form" id="waitlist-form" name="waitlist" method="POST" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="waitlist" />
          <p hidden><label>Leave empty: <input name="bot-field" /></label></p>
          <div class="row">
            <input type="text" name="first_name" placeholder="Your first name" autocomplete="given-name" />
            <input type="email" name="email" placeholder="Your email" required autocomplete="email" />
          </div>
          <button type="submit" class="btn lg">Join the waitlist &nbsp;&rarr;</button>
        </form>
        <div class="thanks" id="thanks">
          <div class="fred">You're on the list.</div>
          <p>Thanks for backing this early. We'll be in touch before anyone else.</p>
        </div>
      </div>
    </section>
  </main>
</Base>
