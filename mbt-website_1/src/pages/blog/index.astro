---
import Play from '../../layouts/Play.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const clean = (t) => (t || '').replace(/quietly /g, '').replace(/ — /g, ', ').replace(/—/g, ', ');
const sq = (w = 220) =>
  `<svg class="sq" viewBox="0 0 ${w} 12" width="${w}" height="12" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 7 Q ${w * 0.15} 1 ${w * 0.3} 6 T ${w * 0.6} 6 T ${w * 0.9} 6 T ${w} 5" fill="none" stroke="#E7457F" stroke-width="4" stroke-linecap="round"/></svg>`;

const cover = (p) =>
  p.data.coverImage
    ? `<div class="cov" style="padding:0"><img src="${p.data.coverImage}" alt="" style="width:100%;height:100%;object-fit:cover;display:block"></div>`
    : `<div class="cov" style="padding:0"><img src="/logo.png" alt="" style="width:60%;margin:auto;object-fit:contain"></div>`;

const feat = posts[0];
const rest = posts.slice(1);
const cats = [...new Set(posts.map((p) => p.data.category))];

const featHtml = feat
  ? `<a class="bl-feat" href="/blog/${feat.slug}/" style="text-decoration:none">${cover(feat)}<div class="bod"><span class="bl-flag">Latest</span><span class="bl-cat">${feat.data.category}</span><h2>${clean(feat.data.title)}</h2><p>${clean(feat.data.description)}</p><span class="bl-more">Read more &rarr;</span></div></a>`
  : '';
const chipsHtml =
  '<span class="bl-chip on" data-cat="all">All</span>' +
  cats.map((c) => `<span class="bl-chip" data-cat="${c}">${c}</span>`).join('');
const cardsHtml = rest
  .map(
    (p) =>
      `<a class="bl-card" data-cat="${p.data.category}" href="/blog/${p.slug}/" style="text-decoration:none">${cover(p)}<div class="bod"><span class="bl-cat">${p.data.category}</span><h3>${clean(p.data.title)}</h3><p>${clean(p.data.description)}</p><span class="bl-more">Read more &rarr;</span></div></a>`
  )
  .join('');

const APP = 'https://apps.apple.com/au/app/mini-brains-play/id6803676635';
const BRAND = `<a class="brand" href="/" aria-label="Mini Brains Play"><img src="/logo-play.png" alt="Mini Brains Play" style="height:42px;display:block"></a>`;
const NAV = `<nav class="nav"><div class="wrap">${BRAND}<div class="navlinks"><a href="/about/">About</a><a href="/school-readiness/">School readiness</a><a href="/pricing/">Pricing</a><a href="/blog/">Blog</a></div><a class="btn btn-pink btn-sm" href="${APP}">Download</a></div></nav>`;
const FOOT = `<footer><div class="wrap"><div class="foot-grid"><div style="max-width:280px">${BRAND}<p style="margin-top:10px;color:#cfe3c7">Screen-free play ideas for you and your Mini. Made in Australia.</p></div><div class="foot-col"><b>Explore</b><a href="/about/">About</a><a href="/school-readiness/">School readiness</a><a href="/pricing/">Pricing</a><a href="/faq/">FAQ</a></div><div class="foot-col"><b>Mini Brains</b><a href="/blog/">Blog</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></div><div class="foot-col"><b>Get it</b><a href="${APP}">Download on iOS</a><a href="https://www.instagram.com/minibrainstrust/">Instagram</a></div></div><div class="foot-btm"><span>© 2026 Mini Brains Play</span><span>Privacy · Terms · Made with care in Australia</span></div></div></footer>`;

const torn = (a, b) =>
  `<div class="torn" style="background:${a}"><svg viewBox="0 0 1200 46" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"><path d="M0 46 L0 20 Q 40 6 90 18 T 200 16 T 320 20 T 460 14 T 600 20 T 760 14 T 900 20 T 1040 15 T 1200 20 L1200 46 Z" fill="${b}"/></svg></div>`;

const body = `${NAV}<main>
<section class="hero" style="min-height:auto;padding:64px 0 26px"><div class="wrap center" style="max-width:760px">
  <div class="kick">The blog</div>
  <h1 class="h-lg" style="color:var(--forest);font-size:46px">Ideas for raising a little human <span class="uline">in an AI world.${sq(250)}</span></h1>
  <p style="font-size:18px;color:#4a4550;max-width:58ch;margin:20px auto 0">Plain, practical reading for busy Australian parents. Screen-free play, the skills that matter most, and real help for the hard hours.</p>
</div></section>
${torn('#F7F1E3', '#FBE0EB')}
<section class="blush pad"><div class="wrap">
  ${featHtml}
  <div class="bl-chips">${chipsHtml}</div>
  <div class="bl-grid">${cardsHtml}</div>
</div></section>
${torn('#FBE0EB', '#F4B740')}
<section class="cta-band pad"><div class="wrap center">
  <h2>Less reading, more playing?</h2>
  <p>Free to download. One good idea is always a tap away.</p>
  <a class="store" style="width:200px;display:inline-block" href="${APP}"><svg viewBox="0 0 186 56" width="100%" xmlns="http://www.w3.org/2000/svg"><rect x="0" y="0" width="186" height="56" rx="12" fill="#111014"/><path fill="#fff" d="M35 22.6c-1.9 0-3 1.1-4.1 1.1-1.2 0-2.4-1-4-1-2.8 0-5.4 2.3-5.4 6.6 0 2.7 1 5.6 2.4 7.4 1 1.3 1.9 2.3 3.1 2.3 1.2 0 1.7-.8 3.2-.8 1.5 0 1.9.8 3.2.8 1.3 0 2.1-1.2 2.9-2.4.9-1.4 1.3-2.7 1.3-2.8-.1 0-2.6-1-2.6-3.9 0-2.5 2-3.6 2.1-3.7-1.2-1.7-3-1.9-3.6-1.9-1.6-.1-3 .9-3.7.9zM33.5 20.9c.7-.8 1.1-1.9 1-3-1 .1-2.1.7-2.8 1.5-.6.7-1.1 1.8-1 2.9 1 .1 2.1-.5 2.8-1.4z"/><text x="52" y="23" fill="#fff" font-family="Quicksand,sans-serif" font-size="9" font-weight="600">Download on the</text><text x="52" y="42" fill="#fff" font-family="Fredoka,sans-serif" font-size="20" font-weight="600">App Store</text></svg></a>
</div></section>
</main>${FOOT}`;
---
<Play
  title="Blog | Mini Brains Play"
  description="Plain, practical reading for parents raising kids in an AI world. Screen-free play, the skills that matter, and getting through the hard hours."
  body={body}
>
  <script is:inline>
    var chips=document.querySelectorAll('.bl-chip'),cards=document.querySelectorAll('.bl-card');
    chips.forEach(function(ch){ch.addEventListener('click',function(){
      chips.forEach(function(c){c.classList.remove('on')});ch.classList.add('on');
      var cat=ch.getAttribute('data-cat');
      cards.forEach(function(cd){cd.style.display=(cat==='all'||cd.getAttribute('data-cat')===cat)?'flex':'none'});
    });});
  </script>
</Play>
